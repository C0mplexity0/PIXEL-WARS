{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "paths": {
      "@pixel-wars/core": ["../pixel-wars-core/src/index.ts"],
      "@pixel-wars/core/*": ["../pixel-wars-core/src/*"]
    }
  }
}
